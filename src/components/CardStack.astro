---
// The stack of index cards on the Design and Web pages. The last, empty card
// closes off the pile (Figma shows a blank card at the bottom); pass `endHref`
// to make it a link.
interface Props {
  label: string;
  endHref?: string;
  endLabel?: string;
}

const { label, endHref, endLabel } = Astro.props;
---

<section class="stack" aria-label={label}>
  <slot />
  {
    endHref ? (
      <a class="end" href={endHref} aria-label={endLabel}>
        <span aria-hidden="true">★</span>
      </a>
    ) : (
      <div class="end" aria-hidden="true" />
    )
  }
</section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    width: min(100%, calc(983 * var(--px)));
    margin: 0 auto;
    padding-top: calc(112 * var(--px));
  }

  .end {
    position: relative;
    z-index: 50;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    min-height: calc(240 * var(--px));
    padding: calc(20 * var(--px)) calc(32 * var(--px));
    background: var(--white);
    border: calc(4 * var(--px)) solid var(--pink);
    border-radius: calc(20 * var(--px));
    color: var(--pink);
    font-size: max(18px, calc(32 * var(--px)));
    text-decoration: none;
  }

  a.end span {
    transition: transform 300ms ease;
  }

  a.end:hover span,
  a.end:focus-visible span {
    transform: rotate(72deg) scale(1.2);
  }

  a.end:focus-visible {
    outline: calc(3 * var(--px)) solid var(--purple);
    outline-offset: calc(4 * var(--px));
  }

  @media (max-width: 700px) {
    .stack {
      padding-top: 0;
    }

    .end {
      min-height: calc(160 * var(--px));
      padding: calc(10 * var(--px)) calc(14 * var(--px));
      border-width: max(1.5px, calc(2 * var(--px)));
      border-radius: calc(10 * var(--px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a.end span {
      transition: none;
    }
  }
</style>
