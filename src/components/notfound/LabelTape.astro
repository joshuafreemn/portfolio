---
// 404 option C, "Label tape": the home desk, with 404 where the name usually
// sits and the label tape spelling out what happened. The folders stay along
// the bottom, so you can pull one open just like on the home page.
import Base from '../../layouts/Base.astro';
import FolderTabs from '../FolderTabs.astro';
import { nav } from '../../data/site';

interface Props {
  noindex?: boolean;
}

const { noindex = true } = Astro.props;
---

<Base title="Page not found · Joshua Freeman" description="This page got lost. Pick a folder to keep looking." noindex={noindex}>
  <main class="home">
    <header class="title">
      <h1>
        <span class="big" aria-hidden="true">404</span>
        <span class="tape">Page not found</span>
      </h1>
      <p class="tape small">Pull a folder to keep looking</p>
      <a class="tape small home-link" href="/">Or go home</a>
    </header>
  </main>
  <FolderTabs tabs={nav} />
</Base>

<style>
  :global(body) {
    overflow: hidden;
  }

  .home {
    position: relative;
    width: calc(1440 * var(--px));
    height: 100dvh;
    margin: 0 auto;
  }

  .title {
    position: absolute;
    top: calc(80 * var(--px));
    right: calc(91 * var(--px));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(4 * var(--px));
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(24 * var(--px));
    margin: 0;
    font-weight: 400;
  }

  /* Same build as the name: white plate, pink letters knocked out of it. */
  .big {
    display: block;
    padding: calc(22 * var(--px)) calc(18 * var(--px)) 0 calc(26 * var(--px));
    background: var(--white);
    border-radius: calc(14 * var(--px));
    color: var(--pink);
    font-family: var(--font-display);
    font-size: calc(330 * var(--px));
    line-height: calc(220 * var(--px));
    letter-spacing: calc(-12 * var(--px));
  }

  .tape {
    display: block;
    padding: calc(3 * var(--px)) calc(10.5 * var(--px)) 0 calc(12 * var(--px));
    background: var(--white);
    border-radius: calc(5 * var(--px));
    color: var(--pink);
    font-family: var(--font-display);
    font-size: calc(79.58 * var(--px));
    line-height: calc(36.6 * var(--px));
    letter-spacing: calc(-3.75 * var(--px));
    text-align: right;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tape.small {
    margin-top: calc(18 * var(--px));
    font-size: calc(48 * var(--px));
    line-height: calc(24 * var(--px));
    letter-spacing: calc(-2 * var(--px));
    rotate: -1.5deg;
  }

  .home-link {
    rotate: 1deg;
    text-decoration: none;
    transition: rotate 300ms var(--spring), translate 300ms var(--spring);
  }

  .home-link:hover,
  .home-link:focus-visible {
    rotate: -2deg;
    translate: 0 calc(-3 * var(--px));
  }

  .home-link:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .big {
      animation: drop 760ms var(--spring) 120ms both;
    }

    .tape {
      animation: tape 520ms cubic-bezier(0.2, 0.8, 0.2, 1) 640ms both;
    }

    .tape.small {
      animation-delay: 900ms;
    }

    .home-link {
      animation-delay: 1080ms;
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      translate: 0 calc(-70 * var(--px));
      rotate: -5deg;
    }
    40% {
      opacity: 1;
    }
  }

  @keyframes tape {
    from {
      clip-path: inset(0 0 0 100% round calc(5 * var(--px)));
    }
    to {
      clip-path: inset(0 0 0 0 round calc(5 * var(--px)));
    }
  }

  @media (max-width: 700px) {
    .home {
      width: 100%;
    }

    .title {
      top: calc(46 * var(--px));
      right: calc(30 * var(--px));
      gap: calc(6 * var(--px));
    }

    h1 {
      gap: calc(9 * var(--px));
    }

    .big {
      padding: calc(9 * var(--px)) calc(8 * var(--px)) 0 calc(12 * var(--px));
      border-radius: calc(6 * var(--px));
      font-size: calc(150 * var(--px));
      line-height: calc(100 * var(--px));
      letter-spacing: calc(-5 * var(--px));
    }

    .tape {
      padding: calc(1 * var(--px)) calc(4 * var(--px)) 0 calc(5 * var(--px));
      border-radius: calc(2 * var(--px));
      font-size: calc(30.76 * var(--px));
      line-height: calc(14.15 * var(--px));
      letter-spacing: calc(-1.4 * var(--px));
    }

    .tape.small {
      font-size: calc(22 * var(--px));
      line-height: calc(12 * var(--px));
      letter-spacing: calc(-0.8 * var(--px));
    }

    /* A 44px tap target around the small tape. */
    .home-link {
      position: relative;
    }

    .home-link::after {
      content: '';
      position: absolute;
      inset: -16px -8px;
    }
  }
</style>
