---
// 404 option B, "Return to sender": the About page's postcard, bounced back
// with a RETURN TO SENDER stamp. The address lines hold the links.
import Base from '../../layouts/Base.astro';
import CloseButton from '../CloseButton.astro';
import { nav } from '../../data/site';

interface Props {
  noindex?: boolean;
}

const { noindex = true } = Astro.props;
---

<Base title="Page not found · Joshua Freeman" description="Nothing lives at this address." noindex={noindex}>
  <header class="top">
    <CloseButton />
  </header>
  <main class="desk">
    <h1 class="sr-only">Page not found</h1>
    <article class="postcard" data-fidget-zone>
      <div class="message">
        <p>Hello,</p>
        <p>Sorry, nothing lives at this address. The page may have moved, or the link has a typo in it.</p>
        <p>Try one of these addresses instead, they all still get post.</p>
        <p class="sign-off">Talk soon,<br />Josh</p>
      </div>
      <nav class="address" aria-label="Try instead">
        <ul class="lines">
          {
            nav.map((tab) => (
              <li>
                <a href={tab.href}>{tab.label}</a>
              </li>
            ))
          }
          <li><a href="/">Home</a></li>
        </ul>
      </nav>
      <div class="stamp-box" aria-hidden="true"><span>404</span></div>
      <p class="returned" aria-hidden="true">
        <span>Return to sender</span>
        <small>Address unknown</small>
      </p>
      <img class="clip" src="/Assets/paperClipPurple.svg" alt="" width="191" height="49" data-fidget="wiggle" />
    </article>
  </main>
</Base>

<style>
  :global(body) {
    --px: min(100vw / 1440, 100dvh / 820, 1.25px);
    overflow-x: hidden;
  }

  .top {
    position: absolute;
    top: calc(33 * var(--px));
    right: calc(60 * var(--px));
    z-index: 20;
  }

  .desk {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: calc(80 * var(--px)) 16px;
  }

  .postcard {
    position: relative;
    display: grid;
    grid-template-columns: calc(430 * var(--px)) calc(330 * var(--px));
    min-height: calc(640 * var(--px));
    padding: calc(46 * var(--px)) calc(34 * var(--px)) calc(40 * var(--px));
    background: var(--white);
    border: calc(18 * var(--px)) solid var(--blue);
    border-radius: calc(33 * var(--px));
    color: var(--black);
    transform: rotate(-2deg);
    transition:
      transform 500ms var(--spring),
      box-shadow 300ms ease;
  }

  @media (hover: hover) and (min-width: 701px) {
    .postcard:hover {
      transform: rotate(-1deg) translateY(calc(-8 * var(--px)));
      box-shadow: 0 calc(16 * var(--px)) calc(28 * var(--px)) rgb(138 74 116 / 0.25);
    }
  }

  .message {
    padding-right: calc(28 * var(--px));
    font-size: max(15px, calc(25 * var(--px)));
    font-weight: 300;
    line-height: 1.1;
    transform: rotate(-0.9deg);
  }

  .message p {
    margin: 0 0 1em;
  }

  .sign-off {
    margin-top: calc(24 * var(--px)) !important;
    text-align: right;
  }

  .address {
    display: flex;
    flex-direction: column;
    padding-left: calc(24 * var(--px));
    border-left: 1px solid var(--black);
  }

  .lines {
    margin: auto 0 calc(20 * var(--px));
    padding: 0;
    list-style: none;
  }

  .lines li {
    border-bottom: 1px solid var(--black);
  }

  .lines a {
    display: flex;
    align-items: flex-end;
    min-height: max(44px, calc(50 * var(--px)));
    padding: 0 0 calc(4 * var(--px)) calc(6 * var(--px));
    color: var(--black);
    font-family: var(--font-display);
    font-size: max(24px, calc(40 * var(--px)));
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 150ms ease,
      translate 300ms var(--spring);
  }

  .lines a:hover,
  .lines a:focus-visible {
    color: var(--ink);
    translate: calc(8 * var(--px)) 0;
  }

  .lines a:focus-visible {
    outline: 2px solid var(--purple);
    outline-offset: 2px;
  }

  .stamp-box {
    position: absolute;
    top: calc(18 * var(--px));
    right: calc(30 * var(--px));
    display: grid;
    place-items: center;
    width: calc(119 * var(--px));
    height: calc(140 * var(--px));
    background:
      radial-gradient(circle at 50% 50%, var(--pink) 0 60%, transparent 61%) 0 0 / 100% 100%,
      var(--pink-bg);
    outline: calc(5 * var(--px)) dotted var(--white);
    outline-offset: calc(-3 * var(--px));
    rotate: 4deg;
    animation: wiggle 900ms ease-out 650ms both;
  }

  .stamp-box span {
    color: var(--white);
    font-family: var(--font-display);
    font-size: calc(62 * var(--px));
    letter-spacing: calc(-2 * var(--px));
  }

  /* The bounce stamp, inked over the message. */
  .returned {
    position: absolute;
    bottom: calc(50 * var(--px));
    left: calc(60 * var(--px));
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: calc(12 * var(--px)) calc(26 * var(--px)) calc(6 * var(--px));
    border: calc(6 * var(--px)) double var(--purple);
    border-radius: calc(10 * var(--px));
    color: var(--purple);
    font-family: var(--font-display);
    line-height: 0.85;
    text-transform: uppercase;
    opacity: 0.8;
    mix-blend-mode: multiply;
    pointer-events: none;
    transform: rotate(-8deg);
    animation: stamp 520ms var(--spring) 400ms both;
  }

  .returned span {
    font-size: calc(60 * var(--px));
    letter-spacing: calc(-2.5 * var(--px));
  }

  .returned small {
    font-size: calc(28 * var(--px));
    letter-spacing: calc(1 * var(--px));
  }

  @keyframes stamp {
    from {
      opacity: 0;
      transform: rotate(-8deg) scale(1.6);
    }
    60% {
      opacity: 0.8;
    }
  }

  .clip {
    position: absolute;
    left: calc(-60 * var(--px));
    bottom: calc(150 * var(--px));
    width: calc(185 * var(--px));
    height: auto;
    transform: rotate(-15deg);
    animation: wiggle 900ms ease-out 500ms both;
  }

  @media (max-width: 700px) {
    :global(body) {
      --px: calc(100vw / 390);
    }

    .top {
      top: 0;
      right: calc(4 * var(--px));
    }

    .desk {
      padding: calc(60 * var(--px)) calc(16 * var(--px));
    }

    .postcard {
      grid-template-columns: 1fr;
      width: 100%;
      padding: calc(28 * var(--px)) calc(18 * var(--px)) calc(20 * var(--px));
      border-width: calc(10 * var(--px));
      border-radius: calc(18 * var(--px));
    }

    .message {
      padding: calc(80 * var(--px)) 0 0;
    }

    .address {
      padding: 0;
      border-left: 0;
    }

    .stamp-box {
      width: calc(70 * var(--px));
      height: calc(84 * var(--px));
    }

    .stamp-box span {
      font-size: calc(34 * var(--px));
    }

    .postcard {
      padding-bottom: calc(100 * var(--px));
    }

    .clip {
      bottom: auto;
      top: calc(-14 * var(--px));
    }

    .returned {
      bottom: calc(24 * var(--px));
      left: calc(30 * var(--px));
    }

    .returned span {
      font-size: calc(40 * var(--px));
    }

    .returned small {
      font-size: calc(19 * var(--px));
    }

    .clip {
      left: calc(-24 * var(--px));
      width: calc(100 * var(--px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .returned,
    .stamp-box,
    .clip {
      animation: none;
    }

    .postcard,
    .lines a {
      transition: none;
    }
  }
</style>
