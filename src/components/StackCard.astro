---
// One index card in the stacked file (Figma "V2a - Work" / "- Work Open").
// Closed, only the title strip shows; the next card covers the rest. Opening a
// card (click, Enter or Space) pushes the cards below it down. Cards that share
// a `group` behave as an accordion: opening one closes the others.
interface Props {
  title: string;
  group: string;
  index: number;
  open?: boolean;
}

const { title, group, index, open = false } = Astro.props;
---

<details class="card" name={group} open={open} style={`--z: ${index + 1}`}>
  <summary class="summary">
    <h2>{title}</h2>
  </summary>
  <div class="content">
    <slot />
  </div>
</details>

<style>
  .card {
    position: relative;
    z-index: var(--z);
    /* The bottom of each card (its rounded corners) tucks under the next. */
    margin-bottom: calc(-20 * var(--px));
    padding-bottom: calc(20 * var(--px));
    background: var(--white);
    border: calc(4 * var(--px)) solid var(--pink);
    border-radius: calc(20 * var(--px));
  }

  .summary {
    display: flex;
    align-items: center;
    height: calc(111 * var(--px));
    padding: 0 calc(31 * var(--px));
    list-style: none;
  }

  summary {
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover h2 {
    transform: translateX(calc(8 * var(--px)));
  }

  summary:focus-visible {
    outline: none;
  }

  summary:focus-visible h2 {
    outline: calc(3 * var(--px)) solid var(--purple);
    outline-offset: calc(4 * var(--px));
  }

  h2 {
    margin: 0;
    color: var(--pink);
    font-family: var(--font-display);
    font-size: calc(100 * var(--px));
    font-weight: 400;
    line-height: 1;
    letter-spacing: calc(-4 * var(--px));
    text-transform: uppercase;
    white-space: nowrap;
    transition: transform 180ms ease;
  }

  .content {
    position: relative;
    min-height: calc(262 * var(--px));
    padding: 0 calc(31 * var(--px)) calc(24 * var(--px));
  }

  @media (max-width: 700px) {
    .card {
      margin-bottom: calc(-10 * var(--px));
      padding-bottom: calc(10 * var(--px));
      border-width: max(1.5px, calc(2 * var(--px)));
      border-radius: calc(10 * var(--px));
    }

    .summary {
      height: calc(44 * var(--px));
      padding: 0 calc(12 * var(--px));
    }

    h2 {
      font-size: calc(34 * var(--px));
      letter-spacing: calc(-1 * var(--px));
      white-space: normal;
    }

    .content {
      min-height: 0;
      padding: calc(4 * var(--px)) calc(12 * var(--px)) calc(16 * var(--px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h2 {
      transition: none;
    }
  }
</style>
