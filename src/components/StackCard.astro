---
// One index card in the stacked file (Figma "V2a - Work" / "- Work Open").
// Closed, only the title strip shows; the next card covers the rest. Hovering
// (or tabbing to) a card opens it, pushing the cards below it down, and
// clicking anywhere on it follows its link. On touch screens there's no hover,
// so a swipe steps from card to card without moving the page, and a tap
// goes straight to the link.
interface Props {
  title: string;
  index: number;
  href?: string;
  /** Open the link in a new tab. */
  external?: boolean;
}

const { title, index, href, external = false } = Astro.props;
---

<article class:list={['card', { linked: href }]} style={`--z: ${index + 1}`} tabindex={href ? undefined : 0}>
  <h2 class="summary">
    {
      href ? (
        <a class="card-link" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
          <span class="title">{title}</span>
          {external && <span class="sr-only">(opens in a new tab)</span>}
        </a>
      ) : (
        <span class="title">{title}</span>
      )
    }
  </h2>
  <div class="drawer">
    <div class="drawer-inner">
      <div class="content">
        <slot />
      </div>
    </div>
  </div>
</article>

<script>
  // Touch screens: the page doesn't scroll. A swipe up or down steps to the
  // next or previous card, which opens (one at a time) and glides into view,
  // so the thumb flicks through the projects. A tap still follows links.
  if (!matchMedia('(hover: hover)').matches) {
    const cards = [...document.querySelectorAll<HTMLElement>('.card')];
    if (cards.length) {
      let at = Math.max(0, cards.findIndex((c) => c.classList.contains('open')));
      const show = (i: number, smooth = true) => {
        at = Math.min(cards.length - 1, Math.max(0, i));
        cards.forEach((card, n) => card.classList.toggle('open', n === at));
        // Only move the page if the open card doesn't fit, so the header and
        // CLOSE stay in view whenever they can.
        const r = cards[at].getBoundingClientRect();
        const fit = r.bottom + scrollY - innerHeight + 16;
        const top = Math.min(r.top + scrollY - 16, Math.max(0, fit));
        scrollTo({ top: Math.max(0, top), behavior: smooth ? 'smooth' : 'auto' });
      };
      show(at, false);

      let startY = 0;
      let startX = 0;
      let moved = false;
      addEventListener('touchstart', (e) => {
        startY = e.touches[0].clientY;
        startX = e.touches[0].clientX;
        moved = false;
      }, { passive: true });
      // Hold the page still while the thumb is down.
      addEventListener('touchmove', (e) => {
        if (e.touches.length === 1) e.preventDefault();
        moved = true;
      }, { passive: false });
      addEventListener('touchend', (e) => {
        if (!moved) return;
        const t = e.changedTouches[0];
        const dy = startY - t.clientY;
        if (Math.abs(dy) < 30 || Math.abs(dy) < Math.abs(t.clientX - startX)) return;
        show(at + (dy > 0 ? 1 : -1));
      });
      addEventListener('resize', () => show(at, false));
    }
  }
</script>

<style>
  .card {
    position: relative;
    z-index: var(--z);
    /* The bottom of each card tucks under the next. Only the top corners are
       rounded, like an index card's tab edge. */
    margin-bottom: calc(-20 * var(--px));
    padding-bottom: calc(20 * var(--px));
    background: var(--white);
    border: calc(4 * var(--px)) solid var(--pink);
    border-radius: calc(20 * var(--px)) calc(20 * var(--px)) 0 0;
    transition:
      transform 450ms var(--spring),
      box-shadow 250ms ease;
  }

  .card:focus-visible {
    outline: none;
  }

  .summary {
    display: flex;
    align-items: center;
    height: calc(111 * var(--px));
    margin: 0;
    padding: 0 calc(31 * var(--px));
    color: var(--pink);
    font-family: var(--font-display);
    font-size: calc(100 * var(--px));
    font-weight: 400;
    line-height: 1;
    letter-spacing: calc(-4 * var(--px));
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Only the title moves on hover: a transform on the link or heading would
     shrink the link's cover to the heading. */
  .title {
    display: inline-block;
    transition: transform 180ms ease;
  }

  .card-link {
    color: inherit;
    text-decoration: none;
  }

  /* The title's link covers the whole card. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible .title,
  .card:not(.linked):focus-visible .title {
    text-decoration: underline;
    text-decoration-thickness: calc(3 * var(--px));
    text-underline-offset: calc(8 * var(--px));
  }

  .drawer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms ease;
  }

  .card.open .drawer {
    grid-template-rows: 1fr;
  }

  /* Opened by scrolling: no slide, so the page can hold its place. */
  @media (hover: none) {
    .drawer {
      transition: none;
    }

    .card.open .content {
      animation: card-in 300ms ease-out;
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
    }
  }

  .drawer-inner {
    min-height: 0;
    overflow: hidden;
  }

  .content {
    position: relative;
    min-height: calc(262 * var(--px));
    padding: 0 calc(31 * var(--px)) calc(24 * var(--px));
  }

  /* Links inside the card (the experiment tiles) sit above the card's own. */
  .content :global(a) {
    position: relative;
    z-index: 2;
  }

  @media (hover: hover) {
    .card.linked {
      cursor: pointer;
    }

    .card:hover .drawer,
    .card:focus-within .drawer,
    .card:focus-visible .drawer {
      grid-template-rows: 1fr;
    }

    /* Lifts off the pile like a picked-up card. */
    .card:hover {
      transform: translateY(calc(-6 * var(--px))) rotate(-0.4deg);
      box-shadow: 0 calc(12 * var(--px)) calc(24 * var(--px)) rgb(138 74 116 / 0.18);
    }

    .card:hover .title {
      transform: translateX(calc(8 * var(--px)));
    }

    /* Pressed back into the pile as you click. */
    .card.linked:active {
      transform: translateY(calc(-2 * var(--px))) rotate(-0.2deg) scale(0.996);
      box-shadow: 0 calc(4 * var(--px)) calc(10 * var(--px)) rgb(138 74 116 / 0.18);
      transition-duration: 90ms;
    }
  }

  @media (max-width: 700px) {
    .card {
      margin-bottom: calc(-10 * var(--px));
      padding-bottom: calc(10 * var(--px));
      border-width: max(1.5px, calc(2 * var(--px)));
      border-radius: calc(10 * var(--px)) calc(10 * var(--px)) 0 0;
    }

    .summary {
      height: calc(44 * var(--px));
      padding: 0 calc(12 * var(--px));
      font-size: calc(34 * var(--px));
      letter-spacing: calc(-1 * var(--px));
      white-space: normal;
    }

    .content {
      min-height: 0;
      padding: calc(4 * var(--px)) calc(12 * var(--px)) calc(16 * var(--px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .title,
    .drawer {
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }
</style>
