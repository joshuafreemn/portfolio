---
// Case study template: At a glance, then The problem · The solution · The
// delivery, the work (story notes between groups) and The outcome, then
// Prev / Next. Sections without copy are left out.
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CloseButton from '../../components/CloseButton.astro';
import { caseStudies, type CaseStudy, type WorkGroup } from '../../data/caseStudies';
import { designProjects, webProjects, experiments } from '../../data/projects';

export const getStaticPaths = (() =>
  caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }))) satisfies GetStaticPaths;

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

// Prev / Next follow the card order on the study's own folder (Design or
// Web, with the experiments after the web projects), skipping projects whose
// case study isn't ready.
const webOrder = [...webProjects, ...experiments];
const isWeb = webOrder.some((p) => p.caseStudy === study.slug);
// The showreel's behind-the-scenes page belongs to the Motion folder and has no neighbours.
const folder =
  study.slug === 'bts'
    ? { projects: [], href: '/showreel.html' }
    : isWeb
      ? { projects: webOrder, href: '/web.html' }
      : { projects: designProjects, href: '/work.html' };
const order = folder.projects
  .map((p) => caseStudies.find((c) => c.slug === p.caseStudy))
  .filter((c): c is CaseStudy => Boolean(c));
const at = order.findIndex((c) => c.slug === study.slug);
// The Design and Web folders run on from one another: the last design
// project's Next goes to the first web project, and back again.
const studiesIn = (projects: { caseStudy?: string }[]) =>
  projects
    .map((p) => caseStudies.find((c) => c.slug === p.caseStudy))
    .filter((c): c is CaseStudy => Boolean(c));
const designStudies = studiesIn(designProjects);
const webStudies = studiesIn(webOrder);
const isLastDesign = !isWeb && study.slug !== 'bts' && at === order.length - 1;
const isFirstWeb = isWeb && at === 0;
const prev = at > 0 ? order[at - 1] : isFirstWeb ? designStudies.at(-1) : undefined;
const next = at < order.length - 1 ? order[at + 1] : isLastDesign ? webStudies[0] : undefined;
const prevLabel = isFirstWeb && prev ? '← Prev: Design' : '← Prev';
const nextLabel = isLastDesign && next ? 'Next: Web →' : 'Next →';

// Clips use their image as the poster frame.
const posters = new Map(
  await Promise.all(
    study.work
      .flatMap((group) => group.images)
      .filter((image) => image.video)
      .map(async (image) => [image.src, (await getImage({ src: image.src, format: 'webp' })).src] as const),
  ),
);

// Pan frames are all the shape of the group's tallest picture. Each picture
// is zoomed to the group's `pan` times the frame width, or further if it
// needs to be to fill the frame's height.
const panFrame = (group: WorkGroup) => {
  const ratio = Math.max(...group.images.map((i) => i.src.height / i.src.width));
  return {
    ratio,
    width: (image: WorkGroup['images'][number]) =>
      Math.max(ratio / (image.src.height / image.src.width), group.pan ?? 1) * 100,
  };
};

// Story notes open a chapter: the note and the groups after it, up to the
// next note, sit together on one panel. Groups before the first note stand
// on their own.
type Chapter = { story?: WorkGroup['story']; groups: { group: WorkGroup; g: number }[] };
const chapters: Chapter[] = [];
study.work.forEach((group, g) => {
  if (group.story || chapters.length === 0) chapters.push({ story: group.story, groups: [] });
  chapters[chapters.length - 1].groups.push({ group, g });
});

// The three notes are pulled out of a pocket like the Experiments cards.
const pockets = [
  study.problem && { title: 'The problem', text: study.problem, color: 'var(--blue)' },
  study.solution && { title: 'The solution', text: study.solution, color: 'var(--purple)' },
  study.delivery && { title: 'The delivery', list: study.delivery, color: 'var(--baby-pink)' },
].filter(Boolean) as { title: string; text?: string; list?: string[]; color: string }[];

const ogImage = study.work[0]?.images[0];
const ogSrc = ogImage ? (await getImage({ src: ogImage.src, width: 1200, format: 'jpg' })).src : undefined;
---

<Base
  title={`${study.title} · Joshua Freeman`}
  description={study.description}
  image={ogSrc}
  bodyClass="case-study"
>
  <div class="page" style={`--bg: ${study.background}`}>
    <div class="close">
      <CloseButton href={folder.href} label="Close and return to the projects" ink />
    </div>

    <main>
      <header class="intro">
        <h1>{study.title}</h1>
        <p class="lede">{study.description}</p>
        {
          study.url && (
            <a class="live" href={study.url} target="_blank" rel="noopener">
              Try it live <span aria-hidden="true">↗</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          )
        }
      </header>

      {
        study.glance && (
          <section class="glance" aria-labelledby="at-a-glance">
            <h2 id="at-a-glance">At a glance</h2>
            <dl>
              {study.glance.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        pockets.length > 0 && (
          <div class="pocket">
            {pockets.map((card, i) => (
              <div class="slot" style={`--tile: ${card.color}; --i: ${i}`}>
              <section class="pull" tabindex="0">
                <h2>{card.title}</h2>
                {card.text && <p>{card.text}</p>}
                {card.list && (
                  <ul>
                    {card.list.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </section>
              </div>
            ))}
          </div>
        )
      }

      <section class="work" aria-labelledby="the-work">
        <h2 id="the-work" class="sr-only">The work</h2>
        {
          chapters.map((chapter) => (
            <div class:list={['chapter', { 'has-story': chapter.story }]}>
              {chapter.story && (
                <section class="note story">
                  <h3>{chapter.story.heading}</h3>
                  <p>{chapter.story.text}</p>
                </section>
              )}
              {chapter.groups.map(({ group, g }) => {
                const columns = group.columns ?? 2;
                // A lone clip shows its caption over itself on hover.
                const overlay = group.images.length === 1 && group.images[0].video && group.caption;
                return (
                  <figure
                    class:list={['group', { single: columns === 1, gallery: group.gallery, carousel: group.slides, small: columns >= 3 || (group.images.length > 0 && group.images.every((image) => image.width)) }]}
                    style={`--columns: ${columns}`}
                  >
                    {group.label && <p class="label">{group.label}</p>}
                    {group.slides && (
                      <div class="slides" tabindex="0" aria-label="Carousel, scroll sideways for more">
                        {group.slides.map((slide, n) => (
                          <div
                            class:list={['slide', { single: (slide.columns ?? 2) === 1 }]}
                            style={`--columns: ${slide.columns ?? 2}`}
                            aria-label={`${n + 1} of ${group.slides!.length}`}
                          >
                            <div class="grid">
                              {slide.images.map((image) => (
                                <div class:list={['tile', { fit: image.width }]}>
                                  <Image
                                    style={image.width ? `max-width: calc(${image.width} * var(--px))` : undefined}
                                    src={image.src}
                                    alt={image.alt}
                                    widths={[Math.min(image.src.width, 700), Math.min(image.src.width, 1400)]}
                                    sizes={`(max-width: 700px) 100vw, ${Math.round(1113 / (slide.columns ?? 2))}px`}
                                    format="webp"
                                    loading="lazy"
                                  />
                                </div>
                              ))}
                            </div>
                            {slide.caption && <p class="slide-caption">{slide.caption}</p>}
                          </div>
                        ))}
                      </div>
                    )}
                    {group.images.length > 0 && (<div
                      class="grid"
                      tabindex={group.gallery ? 0 : undefined}
                      aria-label={group.gallery ? 'Gallery, scroll sideways for more' : undefined}
                    >
                      {group.images.map((image) => group.pan ? (
                        <div class="tile pan-tile" style={`aspect-ratio: 1 / ${panFrame(group).ratio}`}>
                          <div class="pan" tabindex="0" aria-label={`${image.tag ? image.tag + ': ' : ''}drag or scroll to look around`}>
                            <Image
                              style={`width: ${panFrame(group).width(image).toFixed(1)}%`}
                              src={image.src}
                              alt={image.alt}
                              widths={[Math.min(image.src.width, 1400), image.src.width]}
                              sizes={`(max-width: 700px) 200vw, ${Math.round((1113 / columns) * (group.pan ?? 1))}px`}
                              format="webp"
                              loading="lazy"
                              draggable="false"
                            />
                          </div>
                          {image.tag && <span class="tag">{image.tag}</span>}
                          <span class="pan-hint" aria-hidden="true">Drag to explore</span>
                        </div>
                      ) : (
                        <div class:list={['tile', { fit: image.width, overlay }]} tabindex={overlay ? 0 : undefined}>
                          {image.tag && <span class="tag">{image.tag}</span>}
                          {image.video ? (
                            <video
                              src={image.video}
                              poster={posters.get(image.src)}
                              aria-label={image.alt}
                              width={image.src.width}
                              height={image.src.height}
                              autoplay
                              muted
                              loop
                              playsinline
                              preload="metadata"
                            />
                          ) : (
                            <Image
                              style={image.width ? `max-width: calc(${image.width} * var(--px))` : undefined}
                              src={image.src}
                              alt={image.alt}
                              widths={[Math.min(image.src.width, 700), Math.min(image.src.width, 1400)]}
                              sizes={group.gallery ? '(max-width: 700px) 80vw, 700px' : `(max-width: 700px) 100vw, ${Math.round(1113 / columns)}px`}
                              format="webp"
                              loading={g === 0 ? 'eager' : 'lazy'}
                            />
                          )}
                          {overlay && <p class="hover-caption">{group.caption}</p>}
                        </div>
                      ))}
                    </div>)}
                    {(group.gallery || group.slides) && (
                      <div class="gallery-nav">
                        <button type="button" data-step="-1" aria-label="Previous image">←</button>
                        <button type="button" data-step="1" aria-label="Next image">→</button>
                      </div>
                    )}
                    {group.caption && <figcaption class:list={{ 'sr-only': overlay }}>{group.caption}</figcaption>}
                  </figure>
                );
              })}
            </div>
          ))
        }
      </section>

      {
        study.outcome && (
          <section class="note result">
            <h2>The outcome</h2>
            <p>{study.outcome}</p>
          </section>
        )
      }
    </main>

    <nav class="pager" aria-label="Projects">
      {prev ? <a href={`/wrk/${prev.slug}.html`} title={prev.title}>{prevLabel}</a> : <span />}
      <a href={folder.href}>All projects</a>
      {next ? <a href={`/wrk/${next.slug}.html`} title={next.title}>{nextLabel}</a> : <span />}
    </nav>
  </div>
</Base>

<script>
  // Gallery arrows move one picture at a time.
  document.querySelectorAll<HTMLElement>('.gallery, .carousel').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('.slides') ?? gallery.querySelector<HTMLElement>('.grid');
    if (!track) return;
    gallery.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
      button.addEventListener('click', () => {
        const step = Number(button.dataset.step);
        const tiles = [...track.children] as HTMLElement[];
        const left = track.scrollLeft;
        const target =
          step > 0
            ? tiles.find((t) => t.offsetLeft > left + 4)
            : [...tiles].reverse().find((t) => t.offsetLeft < left - 4);
        track.scrollTo({ left: target ? target.offsetLeft : step > 0 ? track.scrollWidth : 0, behavior: 'smooth' });
      });
    });
  });

  // Zoomed diagrams start centred; the mouse drags them around (touch
  // screens and trackpads scroll them natively).
  document.querySelectorAll<HTMLElement>('.pan').forEach((pan) => {
    const centre = () => {
      pan.scrollLeft = (pan.scrollWidth - pan.clientWidth) / 2;
      pan.scrollTop = (pan.scrollHeight - pan.clientHeight) / 2;
    };
    const img = pan.querySelector('img');
    if (img && !img.complete) img.addEventListener('load', centre, { once: true });
    centre();
    const tile = pan.parentElement!;
    const moved = () => tile.classList.add('moved');
    pan.addEventListener('wheel', moved, { passive: true });
    pan.addEventListener('touchstart', moved, { passive: true });

    let start: { x: number; y: number; left: number; top: number } | null = null;
    pan.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      start = { x: event.clientX, y: event.clientY, left: pan.scrollLeft, top: pan.scrollTop };
      pan.setPointerCapture(event.pointerId);
      pan.classList.add('dragging');
      event.preventDefault();
    });
    pan.addEventListener('pointermove', (event) => {
      if (!start) return;
      moved();
      pan.scrollLeft = start.left - (event.clientX - start.x);
      pan.scrollTop = start.top - (event.clientY - start.y);
    });
    const end = () => {
      start = null;
      pan.classList.remove('dragging');
    };
    pan.addEventListener('pointerup', end);
    pan.addEventListener('pointercancel', end);
  });

  // On phones the problem, solution and delivery cards sit in a swipeable
  // pile: the one in front is open, the rest tuck in at the bottom right.
  document.querySelectorAll<HTMLElement>('.pocket').forEach((pocket) => {
    const slots = [...pocket.querySelectorAll<HTMLElement>('.slot')];
    const update = () => {
      const left = pocket.scrollLeft;
      let at = 0;
      slots.forEach((slot, i) => {
        if (Math.abs(slot.offsetLeft - pocket.offsetLeft - left) < Math.abs(slots[at].offsetLeft - pocket.offsetLeft - left)) at = i;
      });
      slots.forEach((slot, i) => {
        slot.classList.toggle('active', i === at);
        slot.style.setProperty('--d', String(i - at));
        slot.style.setProperty('--ad', String(Math.abs(i - at)));
      });
    };
    pocket.addEventListener('scroll', update, { passive: true });
    update();
  });

  // Clips loop on their own; with reduced motion they wait for a press of play.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.work video').forEach((video) => {
      video.pause();
      video.controls = true;
    });
  }
</script>

<style>
  :global(body.case-study) {
    --px: min(100vw / 1440, 1.25px);
    height: auto;
    min-height: 100%;
  }

  .page {
    min-height: 100dvh;
    padding: calc(80 * var(--px)) calc(40 * var(--px)) 0;
    background: var(--bg);
    color: var(--black);
    view-transition-name: case-sheet;
  }

  .close {
    position: fixed;
    top: calc(20 * var(--px));
    right: calc(20 * var(--px));
    z-index: 10;
    /* The white label with dark lettering reads on every page colour. */
    background: var(--ink);
    border-radius: 6px;
  }

  main,
  .pager {
    width: min(100%, calc(1113 * var(--px)));
    margin: 0 auto;
  }

  .intro h1 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: calc(100 * var(--px));
    font-weight: 400;
    line-height: 1;
    letter-spacing: calc(-4 * var(--px));
    text-transform: uppercase;
  }

  .lede {
    max-width: 36em;
    margin: calc(12 * var(--px)) 0 0;
    font-size: max(16px, calc(25 * var(--px)));
    font-weight: 300;
    line-height: 1.4;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 44px;
    margin-top: calc(8 * var(--px));
    color: var(--ink);
    font-family: var(--font-display);
    font-size: max(22px, calc(32 * var(--px)));
    text-transform: uppercase;
    text-decoration: none;
  }

  .live:hover,
  .live:focus-visible {
    text-decoration: underline;
  }

  /* Problem, solution and delivery: coloured cards tucked into a pocket so
     only their tops show. Each pulls out on hover or focus. */
  .pocket {
    --tab: calc(72 * var(--px));
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    --tuck: calc(40 * var(--px));
    height: calc(var(--tab) + var(--tuck));
    margin: calc(48 * var(--px)) 0 calc(-1 * var(--tuck));
    padding: 0 calc(10 * var(--px));
    clip-path: inset(-200vh -60px 0 -60px);
  }

  /* The cards tuck behind the first picture of the work, which sits over the
     bottom of the pocket. */
  .pocket + .work {
    position: relative;
    z-index: 6;
  }

  /* That picture stays put and solid so the cards really are behind it. */
  .pocket + .work .chapter:first-of-type .group:first-of-type .tile {
    animation: none !important;
  }

  /* Each card sits in a fixed slot that takes the hover, so the card can move
     without the pointer slipping off it and making it bounce. Hovering the
     raised card still counts, because it's inside the slot. */
  .slot {
    position: relative;
  }

  .slot + .slot {
    margin-left: calc(-24 * var(--px));
  }

  .slot:hover,
  .slot:focus-within {
    z-index: 1;
  }

  .pull {
    padding: calc(22 * var(--px)) calc(26 * var(--px)) calc(28 * var(--px));
    background: var(--tile);
    box-shadow: 1px 1px 2px rgb(0 0 0 / 0.35);
    color: var(--black);
    font-size: max(15px, calc(19 * var(--px)));
    font-weight: 300;
    line-height: 1.45;
    transform: rotate(calc((var(--i) - 1) * 1.6deg));
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    cursor: default;
  }

  .slot:nth-child(2) .pull {
    color: var(--white);
  }

  .slot:hover .pull,
  .slot:focus-within .pull {
    transform: rotate(0deg) translateY(calc(-100% + var(--tab) - var(--tuck) - 12 * var(--px)));
  }

  .pull:focus-visible {
    outline: calc(3 * var(--px)) solid var(--ink);
    outline-offset: calc(4 * var(--px));
  }

  .pull h2 {
    margin: 0 0 calc(14 * var(--px));
    font-family: var(--font-display);
    font-size: max(26px, calc(40 * var(--px)));
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
  }

  .pull p,
  .pull ul {
    margin: 0;
  }

  .pull ul {
    padding-left: 1.1em;
  }

  /* Touch screens can't hover, so the cards lie open. */
  @media (hover: none) {
    .pocket {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
      gap: calc(20 * var(--px));
      height: auto;
      margin-bottom: calc(48 * var(--px));
      clip-path: none;
    }


    .slot + .slot {
      margin-left: 0;
    }

    .pull,
    .slot:hover .pull,
    .slot:focus-within .pull {
      transform: none;
    }
  }

  .note {
    padding: calc(24 * var(--px)) calc(28 * var(--px));
    background: var(--white);
    border-radius: calc(17 * var(--px));
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.15);
    font-size: max(15px, calc(19 * var(--px)));
    font-weight: 300;
    line-height: 1.45;
  }

  .note:nth-child(odd) {
    transform: rotate(-1deg);
  }

  .note:nth-child(even) {
    transform: rotate(1.2deg);
  }

  .note h2,
  .note h3 {
    margin: 0 0 calc(10 * var(--px));
    color: var(--ink);
    font-family: var(--font-display);
    font-size: max(26px, calc(40 * var(--px)));
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
  }

  .note p,
  .note ul {
    margin: 0;
  }

  .note ul {
    padding-left: 1.1em;
  }

  /* At a glance: one quick-read card for people in a rush. */
  .glance {
    margin: calc(40 * var(--px)) 0 0;
    padding: calc(24 * var(--px)) calc(28 * var(--px));
    background: var(--white);
    border-radius: calc(17 * var(--px));
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.15);
    font-size: max(15px, calc(19 * var(--px)));
    font-weight: 300;
    line-height: 1.4;
  }

  .glance h2 {
    margin: 0 0 calc(14 * var(--px));
    color: var(--ink);
    font-family: var(--font-display);
    font-size: max(26px, calc(40 * var(--px)));
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
  }

  .glance dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: calc(16 * var(--px)) calc(28 * var(--px));
    margin: 0;
  }

  .glance dt {
    font-size: 0.8em;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .glance dd {
    margin: calc(2 * var(--px)) 0 0;
  }

  /* Story notes sit between image groups, so the detail unfolds as you scroll. */
  /* A chapter: its story note and pictures share one panel, with the note
     pinned over the top edge like a label. */
  .chapter {
    display: flex;
    flex-direction: column;
    gap: calc(56 * var(--px));
  }

  .chapter.has-story {
    margin-top: calc(40 * var(--px));
    padding: 0 calc(28 * var(--px)) calc(36 * var(--px));
    background: rgb(0 0 0 / 0.045);
    border-radius: calc(24 * var(--px));
  }

  .note.story {
    position: relative;
    z-index: 1;
    max-width: 40em;
    margin: calc(-40 * var(--px)) 0 calc(-20 * var(--px)) calc(-12 * var(--px));
    transform: rotate(-0.8deg);
  }

  /* A lone picture with a set width hugs its frame. */
  .single .tile.fit {
    justify-self: center;
    width: fit-content;
    padding: 0;
    max-width: 100%;
  }

  .single .tile.fit img {
    width: 100%;
  }

  /* A clip's caption appears over it on hover. */
  .tile.overlay {
    position: relative;
  }

  .hover-caption {
    position: absolute;
    inset: 0 0 auto;
    margin: 0;
    padding: calc(22 * var(--px)) calc(28 * var(--px)) calc(48 * var(--px));
    background: linear-gradient(rgb(0 0 0 / 0.7), transparent);
    color: var(--white);
    font-size: max(14px, calc(18 * var(--px)));
    font-weight: 300;
    line-height: 1.45;
    opacity: 0;
    transform: translateY(calc(-10 * var(--px)));
    transition:
      opacity 250ms ease,
      transform 450ms var(--spring);
    pointer-events: none;
  }

  .tile.overlay:hover .hover-caption,
  .tile.overlay:focus-visible .hover-caption {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .hover-caption {
      position: static;
      background: var(--white);
      color: var(--black);
      opacity: 1;
      transform: none;
    }
  }

  /* A click-through gallery: one row of pictures at the same height. */
  .gallery .grid {
