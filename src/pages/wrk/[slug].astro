---
// Case study template: The brief · The idea · What I did · The work · Where it
// ran, then Prev / Next. Sections without copy are left out.
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CloseButton from '../../components/CloseButton.astro';
import { caseStudies, type CaseStudy } from '../../data/caseStudies';
import { designProjects, webProjects } from '../../data/projects';

export const getStaticPaths = (() =>
  caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }))) satisfies GetStaticPaths;

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

// Prev / Next follow the card order on the study's own folder (Design or
// Web), skipping projects whose case study isn't ready.
const isWeb = webProjects.some((p) => p.caseStudy === study.slug);
const folder = isWeb ? { projects: webProjects, href: '/web.html' } : { projects: designProjects, href: '/work.html' };
const order = folder.projects
  .map((p) => caseStudies.find((c) => c.slug === p.caseStudy))
  .filter((c): c is CaseStudy => Boolean(c));
const at = order.findIndex((c) => c.slug === study.slug);
const prev = at > 0 ? order[at - 1] : undefined;
const next = at < order.length - 1 ? order[at + 1] : undefined;

const ogImage = study.work[0]?.images[0];
const ogSrc = ogImage ? (await getImage({ src: ogImage.src, width: 1200, format: 'jpg' })).src : undefined;
---

<Base
  title={`${study.title} · Joshua Freeman`}
  description={study.description}
  image={ogSrc}
  bodyClass="case-study"
>
  <div class="page" style={`--bg: ${study.background}`}>
    <div class="close">
      <CloseButton href={folder.href} label="Close and return to the projects" />
    </div>

    <main>
      <header class="intro">
        <h1>{study.title}</h1>
        <p class="lede">{study.description}</p>
      </header>

      {
        (study.brief || study.idea || study.whatIDid) && (
          <div class="notes">
            {study.brief && (
              <section class="note">
                <h2>The brief</h2>
                <p>{study.brief}</p>
              </section>
            )}
            {study.idea && (
              <section class="note">
                <h2>The idea</h2>
                <p>{study.idea}</p>
              </section>
            )}
            {study.whatIDid && (
              <section class="note">
                <h2>What I did</h2>
                <ul>
                  {study.whatIDid.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        )
      }

      <section class="work" aria-labelledby="the-work">
        <h2 id="the-work" class="sr-only">The work</h2>
        {
          study.work.map((group, g) => (
            <figure class="group" style={`--columns: ${group.columns ?? 2}`}>
              {group.label && <p class="label">{group.label}</p>}
              <div class="grid">
                {group.images.map((image) => (
                  <div class:list={['tile', { fit: image.width }]}>
                    <Image
                      style={image.width ? `max-width: calc(${image.width} * var(--px))` : undefined}
                      src={image.src}
                      alt={image.alt}
                      widths={[Math.min(image.src.width, 700), Math.min(image.src.width, 1400)]}
                      sizes={`(max-width: 700px) 100vw, ${Math.round(1113 / (group.columns ?? 2))}px`}
                      format="webp"
                      loading={g === 0 ? 'eager' : 'lazy'}
                    />
                  </div>
                ))}
              </div>
              {group.caption && <figcaption>{group.caption}</figcaption>}
            </figure>
          ))
        }
      </section>

      {
        study.result && (
          <section class="note result">
            <h2>Where it ran</h2>
            <p>{study.result}</p>
          </section>
        )
      }
    </main>

    <nav class="pager" aria-label="Projects">
      {prev ? <a href={`/wrk/${prev.slug}.html`}>← Prev</a> : <span />}
      <a href={folder.href}>All projects</a>
      {next ? <a href={`/wrk/${next.slug}.html`}>Next →</a> : <span />}
    </nav>
  </div>
</Base>

<style>
  :global(body.case-study) {
    --px: min(100vw / 1440, 1.25px);
    height: auto;
    min-height: 100%;
  }

  .page {
    min-height: 100dvh;
    padding: calc(80 * var(--px)) calc(40 * var(--px)) 0;
    background: var(--bg);
    color: var(--black);
  }

  .close {
    position: fixed;
    top: calc(20 * var(--px));
    right: calc(20 * var(--px));
    z-index: 10;
    background: var(--pink-bg);
    border-radius: 6px;
  }

  main,
  .pager {
    width: min(100%, calc(1113 * var(--px)));
    margin: 0 auto;
  }

  .intro h1 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: calc(100 * var(--px));
    font-weight: 400;
    line-height: 1;
    letter-spacing: calc(-4 * var(--px));
    text-transform: uppercase;
  }

  .lede {
    max-width: 36em;
    margin: calc(12 * var(--px)) 0 0;
    font-size: max(16px, calc(25 * var(--px)));
    font-weight: 300;
    line-height: 1.4;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: calc(28 * var(--px));
    margin: calc(48 * var(--px)) 0;
  }

  .note {
    padding: calc(24 * var(--px)) calc(28 * var(--px));
    background: var(--white);
    border-radius: calc(17 * var(--px));
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.15);
    font-size: max(15px, calc(19 * var(--px)));
    font-weight: 300;
    line-height: 1.45;
  }

  .note:nth-child(odd) {
    transform: rotate(-1deg);
  }

  .note:nth-child(even) {
    transform: rotate(1.2deg);
  }

  .note h2 {
    margin: 0 0 calc(10 * var(--px));
    color: var(--ink);
    font-family: var(--font-display);
    font-size: max(26px, calc(40 * var(--px)));
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
  }

  .note p,
  .note ul {
    margin: 0;
  }

  .note ul {
    padding-left: 1.1em;
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: calc(56 * var(--px));
  }

  .group {
    margin: 0;
  }

  .label {
    margin: 0 0 calc(10 * var(--px));
    color: var(--ink);
    font-family: var(--font-display);
    font-size: max(24px, calc(40 * var(--px)));
    line-height: 1;
    text-transform: uppercase;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: calc(20 * var(--px));
    align-items: start;
  }

  .tile {
    overflow: hidden;
    background: var(--white);
    border-radius: calc(17 * var(--px));
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.15);
  }

  .tile img {
    display: block;
    width: 100%;
    height: auto;
  }

  .tile.fit {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(40 * var(--px)) calc(20 * var(--px));
  }

  .tile.fit img {
    width: auto;
  }

  figcaption {
    max-width: 40em;
    margin-top: calc(14 * var(--px));
    font-size: max(14px, calc(18 * var(--px)));
    font-weight: 300;
    line-height: 1.45;
  }

  .result {
    margin-top: calc(56 * var(--px));
  }

  .pager {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: calc(80 * var(--px));
    padding-top: calc(20 * var(--px));
    border-top: 1px solid currentColor;
    font-family: var(--font-display);
    font-size: max(24px, calc(40 * var(--px)));
    text-transform: uppercase;
  }

  .pager a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  .pager a:hover,
  .pager a:focus-visible {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    :global(body.case-study) {
      --px: calc(100vw / 390);
    }

    .page {
      padding: calc(64 * var(--px)) calc(16 * var(--px)) 0;
    }

    .intro h1 {
      font-size: calc(44 * var(--px));
      letter-spacing: calc(-1.5 * var(--px));
    }

    .note,
    .note:nth-child(odd),
    .note:nth-child(even) {
      transform: none;
    }

    .grid {
      grid-template-columns: repeat(min(var(--columns), 2), 1fr);
    }

    .tile {
      border-radius: calc(10 * var(--px));
    }
  }
</style>
