---
import Base from '../layouts/Base.astro';
import FolderTabs from '../components/FolderTabs.astro';
import { nav } from '../data/site';
---

<Base>
  <script is:inline>
    // The arrival plays once a visit; coming back home just shows the desk.
    try {
      if (sessionStorage.getItem('arrived')) document.documentElement.classList.add('arrived');
      sessionStorage.setItem('arrived', '1');
    } catch {}
  </script>
  <main class="home">
    <header class="title">
      <h1>
        <img src="/Assets/Joshua Freeman Title.svg" alt="Joshua Freeman" width="685" height="230" />
      </h1>
      <p class="role">Multidisciplinary designer</p>
    </header>
  </main>
  <FolderTabs tabs={nav} />
</Base>

<style>
  :global(body) {
    overflow: hidden;
  }

  .home {
    position: relative;
    width: calc(1440 * var(--px));
    height: 100dvh;
    margin: 0 auto;
  }

  .title {
    position: absolute;
    top: calc(104 * var(--px));
    right: calc(91 * var(--px));
    width: calc(685 * var(--px));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  h1 {
    margin: 0;
    line-height: 0;
  }

  h1 img {
    display: block;
    width: calc(685 * var(--px));
    height: auto;
  }

  .role {
    margin: calc(24 * var(--px)) calc(9 * var(--px)) 0 0;
    width: calc(664 * var(--px));
    height: calc(40 * var(--px));
    /* Matches the white space right of the name's last letter; the extra
       covers the trailing negative letter-spacing. */
    padding: calc(3 * var(--px)) calc(10.5 * var(--px)) 0 0;
    background: var(--white);
    border-radius: calc(5 * var(--px));
    font-family: var(--font-display);
    font-size: calc(79.58 * var(--px));
    line-height: calc(36.6 * var(--px));
    letter-spacing: calc(-3.75 * var(--px));
    text-align: right;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Arrival: the name drops onto the desk and settles, then the role is
     pulled out from under it like a strip of label tape. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.arrived)) h1 {
      animation: drop 760ms var(--spring) 120ms both;
    }

    :global(html:not(.arrived)) .role {
      animation: tape 520ms cubic-bezier(0.2, 0.8, 0.2, 1) 640ms both;
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      translate: 0 calc(-70 * var(--px));
      rotate: -5deg;
    }
    40% {
      opacity: 1;
    }
  }

  @keyframes tape {
    from {
      clip-path: inset(0 0 0 100% round calc(5 * var(--px)));
    }
    to {
      clip-path: inset(0 0 0 0 round calc(5 * var(--px)));
    }
  }

  @media (max-width: 700px) {
    .home {
      width: 100%;
    }

    .title {
      top: calc(46 * var(--px));
      right: calc(30 * var(--px));
      width: calc(256 * var(--px));
    }

    h1 img {
      width: calc(256 * var(--px));
    }

    .role {
      margin: calc(9 * var(--px)) 0 0;
      width: calc(257 * var(--px));
      height: calc(15.5 * var(--px));
      padding: calc(1 * var(--px)) calc(4 * var(--px)) 0 0;
      border-radius: calc(2 * var(--px));
      font-size: calc(30.76 * var(--px));
      line-height: calc(14.15 * var(--px));
      letter-spacing: calc(-1.4 * var(--px));
    }
  }
</style>
