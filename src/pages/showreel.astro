---
// Motion folder (Figma "V2a - Showreel"): the reel, clipped into the folder,
// centred on the screen, with the "Behind the scenes" card peeking up from the
// bottom showing just its title. The page doesn't scroll; hovering the card
// lifts it into view.
import FolderPage from '../layouts/FolderPage.astro';
import { showreel } from '../data/site';

// The behind-the-scenes case study.
const btsHref: string | null = '/wrk/bts.html';
---

<FolderPage
  title="Motion"
  description="Joshua Freeman's motion design showreel: animation and motion graphics across brand, campaign and web."
  current={0}
  fit
>
  <div class="reel" data-fidget-zone>
    <div class="frame">
      {
        showreel.video ? (
          <video src={showreel.video} aria-label={showreel.title} controls playsinline preload="metadata" />
        ) : (
          // A still and a play button stand in for the YouTube player, which
          // only loads (about 1 MB of script) when someone presses play.
          <button type="button" class="facade" data-youtube={showreel.youtubeId} aria-label={`Play ${showreel.title}`}>
            <img
              src={`https://i.ytimg.com/vi/${showreel.youtubeId}/maxresdefault.jpg`}
              onerror={`this.onerror=function(){this.remove()};this.src='https://i.ytimg.com/vi/${showreel.youtubeId}/hqdefault.jpg'`}
              alt=""
              width="1280"
              height="720"
              decoding="async"
            />
            <span class="play" aria-hidden="true"></span>
          </button>
        )
      }
    </div>
    <img class="clip" src="/Assets/paperClip.svg" alt="" width="190" height="48" data-fidget="wiggle" />
  </div>

  {
    btsHref ? (
      <a class="bts" href={btsHref}>
        <h2>Behind the Scenes</h2>
        <p>Showreel: behind the scenes →</p>
      </a>
    ) : (
      <section class="bts" aria-label="Showreel: behind the scenes">
        <h2>Behind the Scenes</h2>
        <p>Coming soon</p>
      </section>
    )
  }
</FolderPage>

<script>
  document.querySelectorAll<HTMLButtonElement>('.facade').forEach((button) => {
    button.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${button.dataset.youtube}?autoplay=1`;
      frame.title = button.getAttribute('aria-label')?.replace(/^Play /, '') ?? '';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.allowFullscreen = true;
      button.replaceWith(frame);
      frame.focus();
    });
  });
</script>

<style>
  .reel {
    position: relative;
    /* Centre the reel on the screen: it's about 649 Figma px tall, and the
       folder body starts 145 below the top of the page. Never closer to the
       tabs than the Figma's 48. */
    padding-top: max(calc(48 * var(--px)), calc((100dvh - 649 * var(--px)) / 2 - 145 * var(--px)));
  }

  .frame {
    aspect-ratio: 1157.6 / 651.2;
    overflow: hidden;
    border-radius: calc(10 * var(--px));
    box-shadow: 0 4px 4px rgb(0 0 0 / 0.25);
    background: var(--black);
    transform: rotate(-0.14deg);
  }

  .facade {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--black);
    cursor: pointer;
  }

  .facade img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(56px, calc(110 * var(--px)));
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 4px 4px rgb(0 0 0 / 0.25);
    translate: -50% -50%;
    transition: scale 400ms var(--spring);
  }

  .play::after {
    content: '';
    position: absolute;
    inset: 30% 26% 30% 38%;
    background: var(--white);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .facade:hover .play,
  .facade:focus-visible .play {
    scale: 1.08;
  }

  iframe,
  video {
    display: block;
    object-fit: cover;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .clip {
    position: absolute;
    top: calc(253 * var(--px));
    left: calc(-62 * var(--px));
    width: calc(184.5 * var(--px));
    height: auto;
    pointer-events: none;
    animation: wiggle 900ms ease-out 500ms both;
  }

  /* Peeks up from the bottom of the screen, showing just its title. */
  .bts {
    --peek: calc(118 * var(--px));
    position: absolute;
    top: calc(100% - var(--peek));
    left: 0;
    right: 0;
    display: block;
    width: calc(983 * var(--px));
    min-height: calc(420 * var(--px));
    margin: 0 auto;
    padding: calc(4 * var(--px)) calc(40 * var(--px)) calc(40 * var(--px));
    background: var(--white);
    border: calc(4 * var(--px)) solid var(--pink);
    border-radius: calc(20 * var(--px));
    color: var(--pink);
    text-decoration: none;
    transform: rotate(2.7deg);
    transition: transform 500ms var(--spring);
  }

  .bts:hover,
  .bts:focus-visible {
    transform: rotate(1.5deg) translateY(calc(-110 * var(--px)));
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(100 * var(--px));
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: calc(-4 * var(--px));
    text-transform: uppercase;
  }

  .bts p {
    margin: calc(24 * var(--px)) 0 0;
    color: var(--purple);
    font-family: var(--font-display);
    font-size: max(22px, calc(40 * var(--px)));
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .reel {
      /* The reel is about 179 px tall here, below 67 px of tab and padding. */
      padding-top: max(calc(80 * var(--px)), calc((100dvh - 179 * var(--px)) / 2 - 67 * var(--px)));
    }

    .frame {
      border-radius: calc(6 * var(--px));
    }

    /* Turned end for end, so its open loop hangs out over the folder's
       right edge. */
    .clip {
      top: auto;
      bottom: calc(-4 * var(--px));
      left: auto;
      right: calc(-46 * var(--px));
      width: calc(98 * var(--px));
      transform: rotate(142deg);
    }

    /* Shows its title and link, so it reads as a way in on touch screens. */
    .bts {
      --peek: calc(96 * var(--px));
      width: calc(100% - 32 * var(--px));
      min-height: calc(200 * var(--px));
      padding: calc(4 * var(--px)) calc(14 * var(--px)) calc(16 * var(--px));
      border-width: max(1.5px, calc(2 * var(--px)));
      border-radius: calc(10 * var(--px));
    }

    h2 {
      font-size: calc(40 * var(--px));
      letter-spacing: calc(-1.5 * var(--px));
    }

    .bts p {
      margin-top: calc(8 * var(--px));
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bts,
    .play {
      transition: none;
    }

    .clip {
      animation: none;
    }
  }
</style>
