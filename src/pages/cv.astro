---
// About folder (Figma "V2a - About"): a postcard with the intro, and the ruled
// "punch card" listing roles and education. The punch card's rules and columns
// are placed at the Figma coordinates (in --s units, one Figma px on desktop).
import { Image } from 'astro:assets';
import FolderPage from '../layouts/FolderPage.astro';
import { cvPdf } from '../data/site';
import stamp from '../assets/about/stamp.png';

const experience = [
  { role: 'Mid-weight Designer', place: 'Smart Soho', current: true },
  { role: 'Team Lead', place: 'Brixton Finishing School' },
  { role: 'Junior Designer', place: 'Smart Soho' },
  { role: 'Graphic Designer', place: 'Procreate LND' },
  { role: 'Graphic Designer', place: 'Early Stage Studio' },
  { role: 'Designer & Content Creator', place: 'Hooked Events' },
];

const education = [
  { course: 'Creative Advertising (BA)', place: 'Lincoln', year: '20' },
  { course: 'AD-ccelerate After Dark', place: 'Brixton', year: '22' },
  { course: 'Interactive Design', place: 'Lincoln', year: '17' },
  { course: 'Creative Media Production', place: 'Stafford', year: '16' },
  { course: 'Various B.C.S Qualifications', place: 'West Notts', year: '21' },
];
---

<FolderPage
  title="About"
  description="About Joshua Freeman, a London-based multidisciplinary designer working across branding, motion and web."
  current={3}
>
  <div class="about">
    <article class="postcard" aria-label="Postcard from Josh" data-fidget-zone>
      <div class="message">
        <p>Hello from London,</p>
        <p>
          I’m Josh, a multidisciplinary designer working across branding, campaigns, print, motion and web. I studied
          Creative Advertising at Lincoln and I’m now a mid-weight designer at Smart Soho, taking projects from pitch to
          launch for clients like Kier and Store Property.
        </p>
        <p>
          I care about a strong idea and the craft to carry it, from a brand identity to a looping social clip. I also
          build my own tools with AI to speed up studio work.
        </p>
        <p class="sign-off">Talk soon,<br />Josh</p>
      </div>
      <div class="address" aria-hidden="true">
        <div class="lines"><span></span><span></span><span></span><span></span><span></span></div>
      </div>
      <div class="stamp-box" aria-hidden="true"></div>
      <Image class="stamp" src={stamp} alt="" width={178} data-fidget="thunk" data-fidget-zone />
      <img class="clip" src="/Assets/paperClipPurple.svg" alt="" width="191" height="49" data-fidget="wiggle" />
    </article>

    <section class="cv" aria-labelledby="cv-title" data-fidget-zone>
      <span class="rule header" aria-hidden="true"></span>
      <span class="rule margin-left" aria-hidden="true"></span>
      <span class="rule margin-right" aria-hidden="true"></span>

      <h2 id="cv-title">Punch card</h2>

      <h3 class="experience-title">Experience</h3>
      <ul class="rows experience">
        {
          experience.map((job) => (
            <li class:list={{ current: job.current }}>
              <span class="cell">
                {job.role} / {job.place}
                {job.current && <span class="sr-only">(current role)</span>}
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="education-title">Education</h3>
      <ul class="rows education">
        {
          education.map((item) => (
            <li>
              <span class="cell">{item.course}</span>
              <span class="cell">
                <span class="sr-only">, </span>
                {item.place}
              </span>
              <span class="cell">
                <span aria-hidden="true">‘{item.year}</span>
                <span class="sr-only">, 20{item.year}</span>
              </span>
            </li>
          ))
        }
      </ul>

      {
        cvPdf && (
          <a class="download" href={cvPdf} download>
            Download CV (PDF)
          </a>
        )
      }
      <img class="clip" src="/Assets/paperClipPurple.svg" alt="" width="191" height="49" data-fidget="wiggle" />
    </section>
  </div>
</FolderPage>

<script>
  // Phones: tap the card underneath to pull it out and lay it on top.
  const about = document.querySelector<HTMLElement>('.about');
  const narrow = matchMedia('(max-width: 700px)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  about?.querySelectorAll<HTMLElement>('.postcard, .cv').forEach((card) => {
    card.addEventListener('click', (event) => {
      if (!narrow.matches || (event.target as HTMLElement).closest('a')) return;
      const isPostcard = card.classList.contains('postcard');
      const onTop = about.classList.contains('postcard-up') === isPostcard;
      if (onTop) return;
      const swap = () => {
        about.classList.toggle('postcard-up', isPostcard);
        card.classList.remove('out');
      };
      if (still.matches) return swap();
      card.classList.add('out');
      setTimeout(swap, 380);
    });
  });
</script>

<style>
  .about {
    /* One Figma px for the punch card. */
    --s: var(--px);
    display: grid;
    /* Postcard spans the first two columns, the punch card the last two, so
       they overlap like the Figma frame. */
    grid-template-columns: calc(470 * var(--px)) calc(353 * var(--px)) 1fr;
    padding: calc(48 * var(--px)) 0 0;
    color: var(--black);
  }

  /* Postcard */
  .postcard {
    position: relative;
    grid-area: 1 / 1 / 2 / 3;
    align-self: start;
    display: grid;
    grid-template-columns: calc(402 * var(--px)) 1fr;
    min-height: calc(606 * var(--px));
    margin-left: calc(-14 * var(--px));
    padding: calc(46 * var(--px)) calc(34 * var(--px)) calc(40 * var(--px));
    background: var(--white);
    border: calc(18 * var(--px)) solid var(--blue);
    border-radius: calc(33 * var(--px));
    transform: rotate(-1.45deg);
    transition:
      transform 500ms var(--spring),
      box-shadow 300ms ease;
  }

  .message {
    padding-right: calc(28 * var(--px));
    font-size: max(14px, calc(23 * var(--px)));
    font-weight: 300;
    line-height: 1;
    transform: rotate(-0.9deg);
  }

  .message p {
    margin: 0 0 1em;
  }

  .sign-off {
    margin-top: calc(24 * var(--px)) !important;
    font-size: max(15px, calc(24 * var(--px)));
    line-height: calc(28 / 24);
    text-align: right;
  }

  .address {
    display: flex;
    flex-direction: column;
    padding-left: calc(24 * var(--px));
    border-left: 1px solid var(--black);
  }

  .lines {
    margin: auto 0 calc(36 * var(--px));
  }

  .lines span {
    display: block;
    height: calc(46 * var(--px));
    border-bottom: 1px solid var(--black);
  }

  .stamp-box {
    position: absolute;
    top: calc(18 * var(--px));
    left: calc(631 * var(--px));
    width: calc(119 * var(--px));
    height: calc(119 * var(--px));
    border: 1px solid var(--black);
  }

  .stamp {
    position: absolute;
    top: calc(9 * var(--px));
    left: calc(596 * var(--px));
    width: calc(178 * var(--px));
    height: auto;
    animation: wiggle 900ms ease-out 650ms both;
  }

  .clip {
    animation: wiggle 900ms ease-out 500ms both;
  }

  .postcard .clip {
    position: absolute;
    left: calc(-60 * var(--px));
    bottom: calc(-6 * var(--px));
    width: calc(185 * var(--px));
    transform: rotate(-15deg);
  }

  /* Punch card: a 711 × 798 sheet, ruled as in the Figma. */
  .cv {
    position: relative;
    z-index: 1;
    grid-area: 1 / 2 / 2 / 4;
    align-self: start;
    width: calc(711 * var(--s));
    height: calc(798 * var(--s));
    margin-top: calc(124 * var(--px));
    background: var(--white);
    border-radius: calc(17 * var(--s));
    transform: rotate(1.17deg);
    font-family: var(--font-display);
    text-transform: uppercase;
    transition:
      transform 500ms var(--spring),
      box-shadow 300ms ease;
  }

  @media (hover: hover) and (min-width: 701px) {
    .postcard:hover {
      transform: rotate(-0.6deg) translateY(calc(-8 * var(--px)));
      box-shadow: 0 calc(16 * var(--px)) calc(28 * var(--px)) rgb(138 74 116 / 0.2);
    }

    .cv:hover {
      transform: rotate(0.4deg) translateY(calc(-8 * var(--px)));
      box-shadow: 0 calc(16 * var(--px)) calc(28 * var(--px)) rgb(138 74 116 / 0.2);
    }
  }

  .rule {
    position: absolute;
    background: var(--black);
  }

  .header {
    top: calc(34 * var(--s));
    left: calc(-6 * var(--s));
    right: 0;
    height: 1px;
  }

  .margin-left {
    top: calc(34 * var(--s));
    bottom: 0;
    left: calc(31 * var(--s));
    width: 1px;
  }

  .margin-right {
    top: calc(48 * var(--s));
    bottom: 0;
    left: calc(674 * var(--s));
    width: 1px;
  }

  h2 {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    margin: 0;
    font-size: calc(55 * var(--s));
    font-weight: 400;
    line-height: calc(36 * var(--s));
    letter-spacing: calc(-2.2 * var(--s));
    text-align: center;
  }

  h3 {
    position: absolute;
    left: calc(78 * var(--s));
    margin: 0;
    font-size: calc(55 * var(--s));
    font-weight: 400;
    line-height: calc(40 * var(--s));
    letter-spacing: calc(-2.2 * var(--s));
  }

  .experience-title {
    top: calc(100 * var(--s));
  }

  .education-title {
    top: calc(382 * var(--s));
  }

  .rows {
    position: absolute;
    left: calc(-6 * var(--s));
    right: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--black);
    list-style: none;
    font-size: calc(40 * var(--s));
    letter-spacing: calc(-1.6 * var(--s));
  }

  .rows li {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    border-bottom: 1px solid var(--black);
  }

  .cell {
    display: flex;
    align-items: center;
    /* Keep the text inside its ruled row (the track would otherwise grow
       to the font's line box and push the text onto the rule below). */
    min-height: 0;
    padding: 0 0 0 calc(7 * var(--s));
    line-height: 1;
    white-space: nowrap;
  }

  /* The inner rule at x = 70, then the text columns. */
  .experience {
    top: calc(145 * var(--s));
  }

  .experience li {
    grid-template-columns: calc(76 * var(--s)) 1fr;
    height: calc(35.6 * var(--s));
  }

  .experience .cell {
    grid-column: 2;
    border-left: 1px solid var(--black);
  }

  .experience li.current::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(53 * var(--s));
    width: calc(15 * var(--s));
    height: calc(15 * var(--s));
    border-radius: 50%;
    background: var(--black);
    transform: translateY(-50%);
  }

  /* Pointing at any other row punches a hole in its margin, showing the
     folder through the card. */
  @media (hover: hover) {
    .rows li:not(.current)::before {
      content: '';
      position: absolute;
      top: 50%;
      left: calc(53 * var(--s));
      width: calc(15 * var(--s));
      height: calc(15 * var(--s));
      border-radius: 50%;
      background: var(--baby-pink);
      box-shadow: inset 0 calc(2 * var(--s)) calc(3 * var(--s)) rgb(0 0 0 / 0.45);
      transform: translateY(-50%) scale(0);
      transition: transform 140ms ease-in;
    }

    .rows li:not(.current):hover::before {
      transform: translateY(-50%) scale(1);
      transition: transform 380ms var(--spring);
    }
  }

  .education {
    top: calc(427 * var(--s));
  }

  .education li {
    grid-template-columns: calc(76 * var(--s)) calc(374 * var(--s)) calc(177 * var(--s)) calc(53 * var(--s)) 1fr;
    height: calc(36.8 * var(--s));
  }

  .education .cell {
    border-left: 1px solid var(--black);
  }

  .education .cell:first-child {
    grid-column: 2;
  }

  .download {
    position: absolute;
    top: calc(660 * var(--s));
    left: calc(78 * var(--s));
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: calc(6 * var(--s)) calc(18 * var(--s)) calc(2 * var(--s));
    background: var(--ink);
    border-radius: calc(5 * var(--s));
    color: var(--white);
    font-size: max(20px, calc(40 * var(--s)));
    text-decoration: none;
  }

  .download:hover,
  .download:focus-visible {
    background: var(--black);
  }

  .cv .clip {
    position: absolute;
    top: calc(14 * var(--s));
    right: calc(-30 * var(--s));
    width: calc(185 * var(--s));
    transform: rotate(-13.7deg);
  }

  /* Phones: the postcard keeps its desktop layout, turned on its side to
     fit, and the punch card lies over it. Tap the card underneath to pull it
     out and lay it on top. The pair fits the screen, so nothing scrolls. */
  @media (max-width: 700px) {
    .about {
      --stage-w: calc(318 * var(--px));
      /* One postcard px: its 606-tall face fills the folder's width. */
      --u: calc(var(--stage-w) / 620);
      --s: calc(var(--stage-w) / 711);
      position: relative;
      display: block;
      /* The visible screen, less the CLOSE bar and room for the browser's
         bottom bar: the cards overlap more on shorter screens. */
      height: calc(100svh - 43 * var(--px) - 24 * var(--px) - 56px - env(safe-area-inset-bottom, 0px));
      min-height: calc(500 * var(--px));
      padding: 0;
    }

    .postcard,
    .cv {
      position: absolute;
      left: 50%;
      margin: 0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition:
        translate 380ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 500ms var(--spring),
        box-shadow 300ms ease;
    }

    .postcard {
      --px: var(--u);
      top: calc((823 - 606) / 2 * var(--u));
      z-index: 1;
      width: calc(823 * var(--u));
      height: calc(606 * var(--u));
      min-height: 0;
      margin-left: calc(-823 / 2 * var(--u));
      transform: rotate(90deg) rotate(-1deg);
      box-shadow: 0 2px 6px rgb(0 0 0 / 0.15);
    }

    .message {
      font-size: 11px;
      line-height: 1.12;
    }

    .message p {
      margin-bottom: 0.8em;
    }

    .sign-off {
      margin-top: calc(10 * var(--u)) !important;
      font-size: 12px;
    }

    .cv {
      bottom: 0;
      z-index: 2;
      margin-left: calc(-711 / 2 * var(--s));
      transform: rotate(0.8deg);
      box-shadow: 0 2px 6px rgb(0 0 0 / 0.15);
    }

    /* Whichever card is on top. */
    .about.postcard-up .postcard {
      z-index: 2;
    }

    .about.postcard-up .cv {
      z-index: 1;
    }

    /* Pulled out to the left from under the other card, then laid on top.
       The paperclips stay where they are, clipped to the folder edge, so they
       move the other way to cancel the slide. The postcard is turned a
       quarter, so its own up is the screen's left. */
    .postcard.out,
    .cv.out {
      translate: calc(-1 * var(--stage-w) * 0.62) 0;
    }

    .postcard.out .clip {
      translate: 0 calc(-1 * var(--stage-w) * 0.62);
    }

    .cv.out .clip {
      translate: calc(var(--stage-w) * 0.62) 0;
    }

    .clip {
      transition: translate 380ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Both paperclips turned end for end, hanging over the folder's right
       edge. The postcard's top edge faces right once it's turned. */
    .postcard .clip {
      left: calc(120 * var(--u));
      right: auto;
      top: calc(-70 * var(--u));
      bottom: auto;
      width: calc(185 * var(--u));
      transform: rotate(-104deg) scaleY(-1);
    }

    .cv .clip {
      top: calc(4 * var(--px));
      right: calc(-40 * var(--px));
      width: calc(90 * var(--px));
      transform: scaleX(-1) rotate(-13.7deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stamp,
    .clip {
      animation: none;
    }

    .postcard,
    .cv,
    .rows li::before {
      transition: none !important;
    }

    .postcard:hover,
    .cv:hover {
      transform: rotate(-1.45deg);
    }

    .cv:hover {
      transform: rotate(1.17deg);
    }
  }
</style>
