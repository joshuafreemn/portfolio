---
// About folder (Figma "V2a - About"): a postcard with the intro, and a ruled
// CV sheet listing roles and education, with contact details and the CV
// download at the foot of the sheet.
import FolderPage from '../layouts/FolderPage.astro';
import { contact, cvPdf, froshting } from '../data/site';

const experience = [
  { role: 'Mid-weight Designer', place: 'Smart Soho', current: true },
  { role: 'Junior Designer', place: 'Smart Soho' },
  { role: 'Graphic Designer', place: 'Procreate LND' },
  { role: 'Graphic Designer', place: 'Early Stage Studio' },
  { role: 'Designer & Content Creator', place: 'Hooked Events' },
];

const education = [
  { course: 'Creative Advertising (BA)', place: 'Lincoln', year: '20' },
  { course: 'AD-ccelerate After Dark', place: 'Brixton', year: '22' },
  { course: 'Interactive Design', place: 'Lincoln', year: '17' },
  { course: 'Creative Media Production', place: 'Stafford', year: '16' },
  { course: 'Various B.C.S Qualifications', place: 'West Notts', year: '21' },
];
---

<FolderPage
  title="About"
  description="About Joshua Freeman, a London-based multidisciplinary designer working across branding, motion and web."
  current={3}
>
  <div class="about">
    <article class="postcard" aria-label="Postcard from Josh">
      <div class="message">
        <p>Hello from London,</p>
        <p>
          Wish you were here! Though I suppose this website will have to do. I’m a graphic designer working across
          branding, motion, and web. My work blends creativity with precision, turning ideas into visuals that move,
          whether on screen or in print.
        </p>
        <p>
          If you’re looking for bold design, sharp storytelling, or just someone to chat pixels and keyframes with,
          drop me a line.
        </p>
        <p class="sign-off">Talk Soon,<br />Josh</p>
      </div>
      <div class="address" aria-hidden="true">
        <div class="stamp"></div>
        <div class="lines"><span></span><span></span><span></span><span></span><span></span></div>
      </div>
      <img class="clip" src="/Assets/paperClipPurple.svg" alt="" width="191" height="49" />
    </article>

    <section class="cv" aria-labelledby="cv-title">
      <h2 id="cv-title">CV.</h2>
      <h3>Experience</h3>
      <ul class="rows">
        {
          experience.map((job) => (
            <li class:list={{ current: job.current }}>
              {job.role} / {job.place}
              {job.current && <span class="sr-only">(current role)</span>}
            </li>
          ))
        }
      </ul>
      <h3>Education</h3>
      <table class="rows">
        <tbody>
          {
            education.map((item) => (
              <tr>
                <td>{item.course}</td>
                <td>{item.place}</td>
                <td>
                  <span aria-hidden="true">‘{item.year}</span>
                  <span class="sr-only">20{item.year}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <h3>Contact</h3>
      <ul class="rows contact">
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
      <p class="froshting">
        Personal animation and illustration live at <a href={froshting} target="_blank" rel="noopener">froshting.com</a>
      </p>
      {
        cvPdf && (
          <a class="download" href={cvPdf} download>
            Download CV (PDF)
          </a>
        )
      }
      <img class="clip" src="/Assets/paperClipPurple.svg" alt="" width="191" height="49" />
    </section>
  </div>
</FolderPage>

<style>
  .about {
    display: grid;
    /* Postcard spans the first two columns, the CV sheet the last two, so they
       overlap like the Figma frame. */
    grid-template-columns: calc(470 * var(--px)) calc(353 * var(--px)) 1fr;
    padding: calc(48 * var(--px)) 0 calc(40 * var(--px));
    color: var(--black);
  }

  /* Postcard */
  .postcard {
    position: relative;
    grid-area: 1 / 1 / 2 / 3;
    align-self: start;
    display: grid;
    grid-template-columns: calc(402 * var(--px)) 1fr;
    min-height: calc(606 * var(--px));
    margin-left: calc(-14 * var(--px));
    padding: calc(46 * var(--px)) calc(34 * var(--px)) calc(40 * var(--px));
    background: var(--white);
    border: calc(18 * var(--px)) solid var(--blue);
    border-radius: calc(33 * var(--px));
    transform: rotate(-1.45deg);
  }

  .message {
    padding-right: calc(28 * var(--px));
    font-size: max(14px, calc(23 * var(--px)));
    font-weight: 300;
    line-height: 1;
    transform: rotate(-0.9deg);
  }

  .message p {
    margin: 0 0 1em;
  }

  .sign-off {
    margin-top: calc(24 * var(--px)) !important;
    font-size: max(15px, calc(24 * var(--px)));
    line-height: calc(28 / 24);
    text-align: right;
  }

  .address {
    display: flex;
    flex-direction: column;
    padding-left: calc(24 * var(--px));
    border-left: 1px solid var(--black);
  }

  .stamp {
    align-self: flex-end;
    width: calc(119 * var(--px));
    height: calc(119 * var(--px));
    border: 1px solid var(--black);
  }

  .lines {
    margin: auto 0 calc(36 * var(--px));
  }

  .lines span {
    display: block;
    height: calc(46 * var(--px));
    border-bottom: 1px solid var(--black);
  }

  .postcard .clip {
    position: absolute;
    left: calc(-60 * var(--px));
    bottom: calc(-6 * var(--px));
    width: calc(185 * var(--px));
    transform: rotate(-15deg);
  }

  /* CV sheet */
  .cv {
    position: relative;
    z-index: 1;
    grid-area: 1 / 2 / 2 / 4;
    align-self: start;
    margin: calc(124 * var(--px)) calc(-31 * var(--px)) 0 0;
    padding: 0 calc(36 * var(--px)) calc(56 * var(--px)) calc(48 * var(--px));
    background:
      linear-gradient(var(--black), var(--black)) calc(26 * var(--px)) 0 / 1px 100% no-repeat,
      var(--white);
    border-radius: calc(17 * var(--px));
    transform: rotate(1.2deg);
    font-family: var(--font-display);
    text-transform: uppercase;
  }

  .cv h2 {
    margin: 0 calc(-36 * var(--px)) 0 calc(-48 * var(--px));
    padding: calc(4 * var(--px)) 0 0;
    border-bottom: 1px solid var(--black);
    font-size: calc(55 * var(--px));
    font-weight: 400;
    line-height: calc(40 / 55);
    letter-spacing: calc(-2.2 * var(--px));
    text-align: center;
  }

  .cv h3 {
    margin: calc(48 * var(--px)) 0 calc(6 * var(--px));
    font-size: calc(55 * var(--px));
    font-weight: 400;
    line-height: 1;
    letter-spacing: calc(-2.2 * var(--px));
  }

  .rows {
    width: 100%;
    margin: 0;
    padding: 0;
    border-collapse: collapse;
    border-top: 1px solid var(--black);
    list-style: none;
    font-size: calc(40 * var(--px));
    line-height: calc(35 / 40);
    letter-spacing: calc(-1.6 * var(--px));
  }

  ul.rows li,
  .rows td {
    padding: calc(4 * var(--px)) 0 calc(2 * var(--px));
    border-bottom: 1px solid var(--black);
  }

  ul.rows li.current {
    position: relative;
  }

  ul.rows li.current::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(-29 * var(--px));
    width: calc(15 * var(--px));
    height: calc(15 * var(--px));
    border-radius: 50%;
    background: var(--black);
    transform: translateY(-50%);
  }

  .rows td + td {
    padding-left: calc(6 * var(--px));
    border-left: 1px solid var(--black);
  }

  .rows td:nth-child(2) {
    width: calc(205 * var(--px));
  }

  .rows td:nth-child(3) {
    width: calc(52 * var(--px));
  }

  .contact {
    text-transform: none;
  }

  .contact a,
  .froshting a {
    color: var(--ink);
    text-underline-offset: 0.15em;
  }

  .froshting {
    margin: calc(24 * var(--px)) 0 0;
    font-family: var(--font-body);
    font-size: max(14px, calc(20 * var(--px)));
    font-weight: 300;
    text-transform: none;
  }

  .download {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: calc(40 * var(--px));
    padding: calc(6 * var(--px)) calc(18 * var(--px)) calc(2 * var(--px));
    background: var(--ink);
    border-radius: calc(5 * var(--px));
    color: var(--white);
    font-size: max(22px, calc(40 * var(--px)));
    text-decoration: none;
  }

  .download:hover,
  .download:focus-visible {
    background: var(--black);
  }

  .cv .clip {
    position: absolute;
    top: calc(14 * var(--px));
    right: calc(-30 * var(--px));
    width: calc(185 * var(--px));
    transform: rotate(-13.7deg);
  }

  @media (max-width: 700px) {
    .about {
      display: flex;
      flex-direction: column;
      gap: calc(28 * var(--px));
      padding-top: calc(8 * var(--px));
    }

    .postcard {
      grid-template-columns: 1fr;
      min-height: 0;
      margin: 0;
      padding: calc(18 * var(--px)) calc(16 * var(--px)) calc(20 * var(--px));
      border-width: calc(9 * var(--px));
      border-radius: calc(18 * var(--px));
    }

    .message {
      padding: 0;
      font-size: 15px;
      line-height: 1.3;
      transform: none;
    }

    .address {
      display: none;
    }

    .postcard .clip {
      left: auto;
      right: calc(-18 * var(--px));
      bottom: auto;
      top: calc(-12 * var(--px));
      width: calc(96 * var(--px));
    }

    .cv {
      margin: 0;
      padding: 0 calc(14 * var(--px)) calc(24 * var(--px)) calc(26 * var(--px));
      background:
        linear-gradient(var(--black), var(--black)) calc(14 * var(--px)) 0 / 1px 100% no-repeat,
        var(--white);
      border-radius: calc(10 * var(--px));
      transform: rotate(0.8deg);
    }

    .cv h2 {
      margin: 0 calc(-14 * var(--px)) 0 calc(-26 * var(--px));
      font-size: calc(36 * var(--px));
      line-height: 1;
    }

    .cv h3 {
      margin-top: calc(22 * var(--px));
      font-size: calc(30 * var(--px));
    }

    .rows {
      font-size: calc(21 * var(--px));
      letter-spacing: 0;
    }

    ul.rows li.current::before {
      left: calc(-17 * var(--px));
      width: calc(8 * var(--px));
      height: calc(8 * var(--px));
    }

    .cv .clip {
      width: calc(96 * var(--px));
      right: calc(-16 * var(--px));
    }
  }
</style>
