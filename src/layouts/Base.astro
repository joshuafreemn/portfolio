---
import '@fontsource/cute-font/latin-400.css';
import '@fontsource/dm-sans/latin-300.css';
import '../styles/tokens.css';
// The same files the @fontsource CSS points at, so they can be preloaded:
// without this the browser only finds them once the CSS is parsed, and the
// headings render twice (fallback, then Cute Font) and shift.
import cuteFont from '@fontsource/cute-font/files/cute-font-latin-400-normal.woff2?url';
import dmSans from '@fontsource/dm-sans/files/dm-sans-latin-300-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph image, relative to the site root. */
  image?: string;
  bodyClass?: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const {
  title = 'Joshua Freeman',
  description = 'Joshua Freeman — multidisciplinary designer working across branding, motion and web.',
  image = '/og.png',
  bodyClass,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Stop phones turning addresses, dates and numbers in the copy into links. -->
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <link rel="preload" href={cuteFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSans} as="font" type="font/woff2" crossorigin />
    <!-- Google Tag Manager and gtag. Skipped inside a frame: the home page
         preloads pages in hidden frames, which shouldn't count as visits.
         They load once the page has finished loading and the browser is
         idle, so their scripts never hold up the page or its animations. -->
    <script is:inline>
      if (window.self === window.top) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-BY3Z1D5197');
        var analytics = function () {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-TNQ9L5VZ');

        var tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-BY3Z1D5197';
        document.head.appendChild(tag);
        };
        var idle = window.requestIdleCallback || function (fn) { setTimeout(fn, 1); };
        var later = function () { idle(analytics, { timeout: 3000 }); };
        if (document.readyState === 'complete') later();
        else addEventListener('load', later, { once: true });
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Joshua Freeman" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/Assets/favicon.png" />
  </head>
  <body class={bodyClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TNQ9L5VZ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>

<script>
  // Fidgets: things on the desk that react when you go near them. Mark an
  // element with data-fidget="wiggle" (paperclips, the close label) or
  // "thunk" (the stamp); it plays when the pointer enters the closest
  // data-fidget-zone around it, or the element itself. One play at a time,
  // and never with reduced motion.
  const moves: Record<string, Keyframe[]> = {
    wiggle: [
      { rotate: '0deg' },
      { rotate: '7deg', offset: 0.2 },
      { rotate: '-5deg', offset: 0.45 },
      { rotate: '2.5deg', offset: 0.7 },
      { rotate: '0deg' },
    ],
    thunk: [
      { scale: '1', rotate: '0deg' },
      { scale: '1.12', rotate: '-4deg', offset: 0.3 },
      { scale: '0.94', rotate: '1deg', offset: 0.55 },
      { scale: '1', rotate: '0deg' },
    ],
  };

  const calm = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-fidget]').forEach((el) => {
    const keyframes = moves[el.dataset.fidget ?? ''];
    if (!keyframes) return;
    let playing: Animation | null = null;
    const zone = el.closest<HTMLElement>('[data-fidget-zone]') ?? el;
    zone.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse' || calm.matches || playing) return;
      playing = el.animate(keyframes, { duration: 700, easing: 'ease-out' });
      playing.onfinish = () => (playing = null);
    });
  });
</script>
