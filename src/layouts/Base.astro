---
import '@fontsource/cute-font/latin-400.css';
import '@fontsource/dm-sans/latin-300.css';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph image, relative to the site root. */
  image?: string;
  bodyClass?: string;
}

const {
  title = 'Joshua Freeman',
  description = 'Joshua Freeman — multidisciplinary designer working across branding, motion and web.',
  image = '/og.png',
  bodyClass,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Tag Manager and gtag. Skipped inside a frame: the home page
         preloads pages in hidden frames, which shouldn't count as visits. -->
    <script is:inline>
      if (window.self === window.top) {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-TNQ9L5VZ');

        var tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-BY3Z1D5197';
        document.head.appendChild(tag);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-BY3Z1D5197');
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Joshua Freeman" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/Assets/favicon.png" />
  </head>
  <body class={bodyClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TNQ9L5VZ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>

<script>
  // Fidgets: things on the desk that react when you go near them. Mark an
  // element with data-fidget="wiggle" (paperclips, the close label) or
  // "thunk" (the stamp); it plays when the pointer enters the closest
  // data-fidget-zone around it, or the element itself. One play at a time,
  // and never with reduced motion.
  const moves: Record<string, Keyframe[]> = {
    wiggle: [
      { rotate: '0deg' },
      { rotate: '7deg', offset: 0.2 },
      { rotate: '-5deg', offset: 0.45 },
      { rotate: '2.5deg', offset: 0.7 },
      { rotate: '0deg' },
    ],
    thunk: [
      { scale: '1', rotate: '0deg' },
      { scale: '1.12', rotate: '-4deg', offset: 0.3 },
      { scale: '0.94', rotate: '1deg', offset: 0.55 },
      { scale: '1', rotate: '0deg' },
    ],
  };

  const calm = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-fidget]').forEach((el) => {
    const keyframes = moves[el.dataset.fidget ?? ''];
    if (!keyframes) return;
    let playing: Animation | null = null;
    const zone = el.closest<HTMLElement>('[data-fidget-zone]') ?? el;
    zone.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse' || calm.matches || playing) return;
      playing = el.animate(keyframes, { duration: 700, easing: 'ease-out' });
      playing.onfinish = () => (playing = null);
    });
  });
</script>
