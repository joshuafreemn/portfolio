# Cache rules for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# Built assets have a content hash in their name, so they never change and can
# be cached for a year. Pages themselves always revalidate so a new deploy
# shows straight away.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Case-study clips and the shared SVGs keep their names between deploys,
# so cache them for a week and let the browser check back after.
/wrk/*/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/Assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og.png
  Cache-Control: public, max-age=604800
